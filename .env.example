# Copy to `.env` and adjust as needed. `.env` is gitignored.

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_DOCUMENTS_RAW=documents.raw
TOPIC_DOCUMENTS_DLQ=documents.dlq
TOPIC_CHUNKS=chunks.embed

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

# --- Postgres (metadata registry) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_registry

# --- Redis (Celery broker/result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Embeddings (local sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Chunking constraints ---
CHUNK_MIN_TOKENS=128
CHUNK_MAX_TOKENS=512

# --- Claude (generation + eval judge) ---
# Auth resolves via ANTHROPIC_API_KEY or `ant auth login`; leave key unset to use a profile.
# ANTHROPIC_API_KEY=
GEN_MODEL=claude-opus-4-8
JUDGE_MODEL=claude-haiku-4-5

# --- Paths ---
INBOX_DIR=./inbox
